{
  "expo": {
    "name": "Mizan Connect",
    "slug": "mizan-client-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mizan-app-icon.png",
    "scheme": "mizan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mizan.client",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mizan.client",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B1412",
        "foregroundImage": "./assets/images/mizan-app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mizan.team",
              "pathPrefix": "/accept-invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/mizan-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111816",
          "image": "./assets/images/mizan-z-on-dark.png",
          "imageWidth": 150
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Mizan Connect uses Face ID to unlock the app when you have turned the app lock on."
        }
      ],
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Mizan uses your camera to photograph receipts so your accountant can review and record them.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mizan needs access to your photos so you can upload an existing receipt image."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Mizan uses your microphone to record voice messages for your accountant and voice questions for the AI Advisor.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c346a3f8-ce8e-49a1-8fa2-e6c0b860cdd6"
      }
    },
    "owner": "mizan92s-team"
  }
}
