{
  "expo": {
    "name": "Mizan",
    "slug": "mizan-client-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mizan-mark.png",
    "scheme": "mizan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mizan.client",
      "supportsTablet": true
    },
    "android": {
      "package": "com.mizan.client",
      "adaptiveIcon": {
        "backgroundColor": "#F9F9FE",
        "foregroundImage": "./assets/images/mizan-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/mizan-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9F9FE",
          "image": "./assets/images/mizan-mark.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
