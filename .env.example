# ============================================================
# MIZAN Client App (native) — Environment
# Copy this file to .env and fill in real values. NEVER commit .env.
#
# Only EXPO_PUBLIC_* values are inlined into the app bundle — they must be
# client-safe. The Supabase anon key is designed to be public and is protected
# by Row-Level Security. Service-role / Claude / Stripe keys must NEVER appear
# here or anywhere in this app — they live only in Supabase edge functions.
# ============================================================

# Supabase (same project as balance-beams-ai / firm-guide-app)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Web app base URL — opened for browser-based flows (e.g. renewal payment link)
EXPO_PUBLIC_WEB_APP_URL=https://mizan.team
